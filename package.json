{
  "name": "copilot-cost-analyzer",
  "private": true,
  "version": "0.7.0",
  "description": "Local app to understand and optimize GitHub Copilot Chat's token usage and AI Credits cost — learn how prompt caching and token accounting work, analyze your own session logs, and export metadata for AI-assisted cost advice. Monorepo root.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raulkivi/copilot-cost-analyzer.git"
  },
  "homepage": "https://github.com/raulkivi/copilot-cost-analyzer#readme",
  "bugs": {
    "url": "https://github.com/raulkivi/copilot-cost-analyzer/issues"
  },
  "workspaces": [
    "packages/domain",
    "packages/server",
    "packages/web",
    "packages/pi-system-prompt-logger"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=packages/server & npm run dev --workspace=packages/web",
    "start": "bash scripts/dev-open.sh",
    "configure": "bash scripts/install.sh",
    "unconfigure": "bash scripts/uninstall.sh",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.1",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0"
  }
}
