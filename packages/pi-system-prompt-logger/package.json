{
  "name": "@copilot-cost-analyzer/pi-system-prompt-logger",
  "private": true,
  "version": "0.1.0",
  "description": "Pi coding-agent extension that logs the fully assembled system prompt once per session.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.build.json",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist/pi-system-prompt-logger.js"
  },
  "license": "MIT",
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "esbuild": "^0.28.2",
    "vitest": "^5.0.2"
  }
}
